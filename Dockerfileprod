FROM node:16.15-alpine AS build
ARG RB_GITLAB_TOKEN
ADD ./ /ng-kmt
WORKDIR /ng-kmt
COPY package.json .
RUN npm install -g @angular/cli@15.1.0
COPY . /prodx-fe
RUN export RB_GITLAB_TOKEN=${RB_GITLAB_TOKEN}

# A head-of-time compilation
RUN npm install 
#RUN ng build --configuration="development"
RUN $(npm bin)/ng build --aot --build-optimizer --vendor-chunk=true --configuration production

FROM nginx:alpine
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=build /ng-kmt/dist/prodx-fe /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]